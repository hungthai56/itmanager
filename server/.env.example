# Configure in web server environment or /server/config.local.php OUTSIDE public/.
LOTUS_DB_HOST=127.0.0.1
LOTUS_DB_PORT=3306
LOTUS_DB_NAME=lotus_it
LOTUS_DB_USER=lotus_api
LOTUS_DB_PASSWORD=REPLACE_WITH_32_BYTE_RANDOM_SECRET
# 1 for local development only, never on a public server:
LOTUS_ALLOW_HTTP_LOCALHOST=0